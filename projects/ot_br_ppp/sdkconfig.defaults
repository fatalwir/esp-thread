#
# Flash / partition table  -- 4 MB, the smallest ESP32-C6 module
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

#
# OTA updates from the web interface, with rollback. A new image runs on
# probation until esp_ot_br.c confirms it, which it does once the PPP link to
# the router is up. If the board resets before that, the bootloader boots the
# previous image again.
#
CONFIG_BOOTLOADER_APP_ROLLBACK=y
CONFIG_BOOTLOADER_APP_ROLLBACK_CONFIRM_BY_APP=y

#
# Console split
#   "UART" connector -> ROM/bootloader output, ESP_LOG, OpenThread CLI
#   "USB"  connector -> PPP only
#
# ESP_CONSOLE_SECONDARY_NONE is essential, not cosmetic. The default is
# ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG, which mirrors log output onto the very
# endpoint PPP uses and would inject text into the frame stream.
#
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

#
# PPP
#
# This board is the PPP *client*. The upstream router runs the PPP server,
# authenticates the board (PAP or CHAP, credentials in network.defaults) and
# assigns its IPv4 address, gateway and DNS server over IPCP. See the README.
#
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y

#
# lwIP -- IPv6 forwarding and the hooks the border router installs
#
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# struct netif layout must match the prebuilt libopenthread_br.a, which reads
# netif->flags and netif->num at fixed offsets. That library is built without
# PPP and has 4 client_data slots; CONFIG_LWIP_PPP_SUPPORT adds a fifth for
# esp-netif, shifting both fields by 4 bytes. The border router then reads
# hwaddr_len (0 on PPP) as the interface number and a random bit as "up", and
# `ot br state` stays "stopped". Dropping DHCP address conflict detection
# frees one slot (LWIP_ACD). Nothing here uses DHCP: the backbone is PPP.
# main/esp_ot_br.c checks both offsets at compile time.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y

#
# OpenThread -- single SoC, native 802.15.4 radio, no RCP
#
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_TASK_SIZE=10240
CONFIG_OPENTHREAD_PLATFORM_NETIF=y

# CLI on the UART console. CONSOLE_ENABLE stays off because the example
# supplies its own esp_console REPL with the "ot" prefix (ot_console_start()).
CONFIG_OPENTHREAD_CLI=y
CONFIG_OPENTHREAD_CONSOLE_ENABLE=n
CONFIG_OPENTHREAD_CLI_ESP_EXTENSION=y
CONFIG_OPENTHREAD_CLI_WIFI=n

# No Wi-Fi in this design, so no radio coexistence: the 802.15.4 radio has the
# single RF path to itself. This is the main reason a wired backbone beats
# Wi-Fi on a C6.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

#
# OpenThread features that the ot_cli build did not have
#
# Free with CONFIG_OPENTHREAD_BORDER_ROUTER=y (see
# openthread-core-esp32x-ftd-config.h): BORDER_ROUTING, NAT64_BORDER_ROUTING,
# SRP_SERVER, DNS_UPSTREAM_QUERY, BACKBONE_ROUTER -- and, because they default
# to BORDER_ROUTING_ENABLE, also TMF_NETDIAG_CLIENT and MESH_DIAG, i.e. the
# `networkdiagnostic` and `meshdiag` CLI commands.
#
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_BORDER_AGENT_ENABLE=y
CONFIG_OPENTHREAD_COMMISSIONER=y
CONFIG_OPENTHREAD_JOINER=y
CONFIG_OPENTHREAD_DIAG=y
CONFIG_OPENTHREAD_LINK_METRICS=y
CONFIG_OPENTHREAD_MACFILTER_ENABLE=y
CONFIG_OPENTHREAD_RADIO_STATS_ENABLE=y

# Thread-native time distribution. Left OFF on purpose: it changes what goes
# on the air, so every node in the mesh must be built with it or things get
# strange. Turn it on here AND in projects/ot_cli together, or use SNTP
# instead. See the README.
CONFIG_OPENTHREAD_TIME_SYNC=n

# Macros with no Kconfig switch of their own.
CONFIG_OPENTHREAD_HEADER_CUSTOM=y
CONFIG_OPENTHREAD_CUSTOM_HEADER_PATH="main"
CONFIG_OPENTHREAD_CUSTOM_HEADER_FILE_NAME="esp_ot_custom_config.h"

# The DNS64 client is for Thread-only nodes: once a NAT64 prefix exists it
# overwrites the main DNS server (global in lwIP) with
# CONFIG_OPENTHREAD_DNS_SERVER_ADDR wrapped in that prefix
# (esp_openthread_state.c). A border router has real IPv4, and here its DNS
# server is the one the router hands out over IPCP, so keep it off.
CONFIG_OPENTHREAD_DNS64_CLIENT=n

#
# Thread network -- identical dataset to projects/ot_cli and ot_br_eth, so all
# of them join the same mesh.
# Placeholder test dataset. Put your real one in network.defaults at the
# repository root (see network.defaults.example); it overrides these.
#
CONFIG_OPENTHREAD_NETWORK_AUTO_START=y
CONFIG_OPENTHREAD_NETWORK_NAME="ESPThreadTest"
CONFIG_OPENTHREAD_NETWORK_CHANNEL=15
CONFIG_OPENTHREAD_NETWORK_PANID=0x4257
CONFIG_OPENTHREAD_NETWORK_EXTPANID="1111111122222222"
CONFIG_OPENTHREAD_NETWORK_MASTERKEY="000102030405060708090a0b0c0d0e0f"
CONFIG_OPENTHREAD_NETWORK_PSKC="0102030405060708090a0b0c0d0e0f10"

#
# mbedTLS -- Thread commissioning / DTLS
#
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

#
# mDNS -- how SRP registrations from the mesh get advertised on the backbone
#
CONFIG_MDNS_MULTIPLE_INSTANCE=y

#
# System
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
